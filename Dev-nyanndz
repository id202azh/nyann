-- FPS Counter
local function updateFPS()
	local lastTime = tick()
	local frames = 0
	task.spawn(function()
		while true do
			frames = frames + 1
			if tick() - lastTime >= 1 then
				local fps = frames
				frames = 0
				lastTime = tick()
				
				if fps >= 60 then
					fpsLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
				elseif fps >= 30 then
					fpsLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
				else
					fpsLabel.TextColor3 = Color3.fromRGB(120, 120, 120)
				end
				
				fpsLabel.Text = "FPS: " .. fps
			end
			task.wait()
		end
	end)
end

local function updateTime()
	task.spawn(function()
		while true do
			local now = os.date("*t")
			timeLabel.Text = string.format("%02d:%02d:%02d", now.hour, now.min, now.sec)
			task.wait(1)
		end
	end)
end

updateFPS()
updateTime()

