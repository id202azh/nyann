-- Trạng thái
local hasSelected = false
local selectedVersion = ""
local isStarted = false

-- Hiệu ứng hover
local function addHoverEffect(button)
	button.MouseEnter:Connect(function()
		if isStarted then return end
		button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		if button:FindFirstChildOfClass("UIStroke") then
			button.UIStroke.Color = Color3.fromRGB(220, 220, 220)
			button.UIStroke.Thickness = 2.8
		end
	end)
	
	button.MouseLeave:Connect(function()
		if isStarted then return end
		if hasSelected and selectedVersion == button.Name then
			return
		end
		button.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
		if button:FindFirstChildOfClass("UIStroke") then
			button.UIStroke.Color = Color3.fromRGB(90, 90, 90)
			button.UIStroke.Thickness = 1.8
		end
	end)
end

local function glowButton(button)
	button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	if button:FindFirstChildOfClass("UIStroke") then
		button.UIStroke.Color = Color3.fromRGB(255, 255, 255)
		button.UIStroke.Thickness = 3.2
	end
end

local function unglowButton(button)
	button.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	button.TextColor3 = Color3.fromRGB(200, 200, 200)
	if button:FindFirstChildOfClass("UIStroke") then
		button.UIStroke.Color = Color3.fromRGB(90, 90, 90)
		button.UIStroke.Thickness = 1.8
	end
end

local function glowStartButton(version)
	startButton.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
	startButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	startStroke.Color = Color3.fromRGB(240, 240, 240)
	startStroke.Thickness = 3
	if version == "v1" then
		startButton.Text = "EXECUTE V1"
	elseif version == "v2" then
		startButton.Text = "EXECUTE V2"
	end
end

local function unglowStartButton()
	startButton.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
	startButton.TextColor3 = Color3.fromRGB(240, 240, 240)
	startStroke.Color = Color3.fromRGB(160, 160, 160)
	startStroke.Thickness = 2.2
	startButton.Text = "EXECUTE"
end

addHoverEffect(buttonV1)
addHoverEffect(buttonV2)

startButton.MouseEnter:Connect(function()
	if isStarted then return end
	startButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
end)

startButton.MouseLeave:Connect(function()
	if isStarted then return end
	if hasSelected then
		glowStartButton(selectedVersion)
	else
		unglowStartButton()
	end
end)

buttonV1.MouseButton1Click:Connect(function()
	if isStarted then return end
	
	if hasSelected and selectedVersion == "v1" then
		unglowButton(buttonV1)
		unglowStartButton()
		hasSelected = false
		selectedVersion = ""
		return
	end
	
	unglowButton(buttonV1)
	unglowButton(buttonV2)
	
	hasSelected = true
	selectedVersion = "v1"
	glowButton(buttonV1)
	glowStartButton("v1")
end)

buttonV2.MouseButton1Click:Connect(function()
	if isStarted then return end
	
	if hasSelected and selectedVersion == "v2" then
		unglowButton(buttonV2)
		unglowStartButton()
		hasSelected = false
		selectedVersion = ""
		return
	end
	
	unglowButton(buttonV1)
	unglowButton(buttonV2)
	
	hasSelected = true
	selectedVersion = "v2"
	glowButton(buttonV2)
	glowStartButton("v2")
end)

local function loadScript(version, url)
	if isStarted then return end
	
	if not hasSelected then
		startButton.Text = "SELECT FIRST"
		startButton.TextColor3 = Color3.fromRGB(140, 140, 140)
		task.wait(1.1)
		unglowStartButton()
		return
	end
	
	isStarted = true
	
	frame:TweenSize(UDim2.new(0, 0, 0, 0), "Out", "Quad", 0.35, true)
	task.wait(0.35)
	screenGui:Destroy()
	
	local success, err = pcall(function()
		loadstring(game:HttpGet(url))()
	end)
	
	if not success then
		warn("Lỗi khi tải " .. version .. ": " .. tostring(err))
	end
end

startButton.MouseButton1Click:Connect(function()
	if selectedVersion == "v1" then
		loadScript("v1", "https://raw.githubusercontent.com/nyannos/nyannos/refs/heads/main/nyannos.lua")
	elseif selectedVersion == "v2" then
		loadScript("v2", "https://raw.githubusercontent.com/nyannos/nyannos/refs/heads/main/nyannos2.lua")
	end
end)

