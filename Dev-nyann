-- Biến trạng thái
local hasSelected = false
local isMinimized = false
local selectedVersion = ""
local isStarted = false

-- Chức năng thu nhỏ/ẩn
minimizeBtn.MouseButton1Click:Connect(function()
    if isMinimized then
        frame.Size = UDim2.new(0, 450, 0, 380)
        frame.Position = UDim2.new(0.5, -225, 0.5, -190)
        frame.BackgroundTransparency = 0
        for _, child in pairs(frame:GetChildren()) do
            if child ~= minimizeBtn and child ~= closeBtn then
                child.Visible = true
            end
        end
        minimizeBtn.Text = "-"
        isMinimized = false
    else
        frame.Size = UDim2.new(0, 70, 0, 35)
        frame.Position = UDim2.new(1, -80, 0, 5)
        frame.BackgroundTransparency = 0.3
        for _, child in pairs(frame:GetChildren()) do
            if child ~= minimizeBtn and child ~= closeBtn then
                child.Visible = false
            end
        end
        minimizeBtn.Text = "+"
        isMinimized = true
    end
end)

