-- Tạo hiệu ứng sáng viền cho nút (màu trắng)
local function glowButton(button, enable)
    if enable then
        button.BorderColor3 = Color3.fromRGB(255, 255, 255)
        button.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
        button.TextColor3 = Color3.fromRGB(255, 255, 255)
        for i = 3, 8, 0.5 do
            button.BorderSizePixel = i
            task.wait(0.05)
        end
    else
        button.BorderColor3 = Color3.fromRGB(180, 180, 180)
        button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        button.TextColor3 = Color3.fromRGB(220, 220, 220)
        button.BorderSizePixel = 3
    end
end

-- Tạo hiệu ứng sáng viền cho khung START (màu trắng)
local function glowStartFrame(enable, version)
    if enable then
        startFrame.BorderColor3 = Color3.fromRGB(255, 255, 255)
        startFrame.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        startText.TextColor3 = Color3.fromRGB(200, 255, 200)
        startText.Text = ">> " .. version .. " ✓"
        for i = 2, 6, 0.5 do
            startFrame.BorderSizePixel = i
            task.wait(0.05)
        end
    else
        startFrame.BorderColor3 = Color3.fromRGB(150, 150, 150)
        startFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        startText.TextColor3 = Color3.fromRGB(150, 255, 150)
        startText.Text = "START: Chọn phiên bản"
        startFrame.BorderSizePixel = 2
    end
end

-- Hàm load script (menu sẽ tắt ngay lập tức)
local function loadScript(version, url)
    if isStarted then
        print("Đang tải " .. version .. "...")
        return
    end
    
    if not hasSelected then
        startText.Text = ">> VUI LÒNG CHỌN PHIÊN BẢN!"
        startText.TextColor3 = Color3.fromRGB(255, 200, 50)
        task.wait(1.5)
        startText.Text = "START: Chọn phiên bản"
        startText.TextColor3 = Color3.fromRGB(150, 255, 150)
        return
    end
    
    isStarted = true
    
    -- Ẩn menu ngay lập tức trước khi tải script
    screenGui:Destroy()
    
    -- Tải script sau khi menu đã biến mất
    local success, err = pcall(function()
        loadstring(game:HttpGet(url))()
    end)
    
    if not success then
        warn("Lỗi khi tải " .. version .. ": " .. tostring(err))
        -- Có thể tạo thông báo lỗi ở đây nếu cần
    end
end

-- Xử lý click nút v1
buttonV1.MouseButton1Click:Connect(function()
    if isStarted then return end
    
    if hasSelected and selectedVersion == "v1" then
        glowButton(buttonV1, false)
        glowStartFrame(false)
        hasSelected = false
        selectedVersion = ""
        return
    end
    
    if hasSelected then
        glowButton(buttonV1, false)
        glowButton(buttonV2, false)
    end
    
    hasSelected = true
    selectedVersion = "v1"
    glowButton(buttonV1, true)
    glowStartFrame(true, "nyann os v1")
    startText.Text = ">> nyann os v1 ✓"
end)

